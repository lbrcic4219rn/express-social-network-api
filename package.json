  "bugs": {
    "url": "https://github.com/lbrcic4219rn/SkriptniJeziciProjekatVezbe/issues"
  },
  "homepage": "https://github.com/lbrcic4219rn/SkriptniJeziciProjekatVezbe#readme",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "joi": "^18.2.3",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.23.3",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "sequelize-cli": "^6.6.5"
  },
  "engines": {
    "node": ">=20"
  },
