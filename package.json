{
  "name": "express-social-network-api",
  "version": "1.0.0",
  "description": "A social network REST API built with Express and Sequelize: users, posts, stories, comments and tags behind a JWT protected router, with a separate auth service.",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "start:auth": "node app_auth.js",
    "dev": "nodemon app.js",
    "dev:auth": "nodemon app_auth.js",
    "migrate": "sequelize-cli db:migrate",
    "seed": "sequelize-cli db:seed:all"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lbrcic4219rn/SkriptniJeziciProjekatVezbe.git"
  },
  "author": "",
