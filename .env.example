ACCESS_TOKEN_SECRET=

# Database (defaults suit a local MySQL; docker compose overrides DB_HOST)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=social_network

# Origins allowed to call the auth service (comma separated)
CLIENT_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Seeded admin account (seeders/20260812120000-admin-user.js)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
